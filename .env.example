# ============ LogSentinel 环境变量示例 ============
# 首次部署时复制为 .env 并修改所有密钥；.env 不得提交到 Git

# MySQL root 密码（同时作为后端连接密码）
MYSQL_ROOT_PASSWORD=please-change-me
MYSQL_DATABASE=logsentinel

# JWT 签名密钥（至少 32 字节随机串，推荐 openssl rand -hex 32）
JWT_SECRET=please-change-me-at-least-32-bytes-long-secret

# 敏感字段 AES 加密密钥（必须正好 16 字节，推荐 openssl rand -hex 16）
AES_KEY=please-change-16

# 初始管理员密码（仅首次初始化生效，首次登录强制修改）
ADMIN_INITIAL_PASSWORD=Admin@123

# Web 访问端口
WEB_PORT=6064

# 宿主机被采集日志的根目录（只读挂载到容器 /logs，仅本机模式需要）
LOG_ROOT=/var/log

# 默认钉钉渠道（可选：首次启动自动入库；不填则不预置）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 默认邮件渠道（可选：首次启动自动入库）
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
